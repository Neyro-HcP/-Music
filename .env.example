# Copy this file to .env and set your own values before running the site.
PORT=3000
NODE_ENV=development
ADMIN_PASSWORD=replace-this-with-a-long-private-password
SESSION_SECRET=replace-this-with-a-long-random-secret
# Optional: path where audio, cover art and the catalogue are stored.
# DATA_DIR=./data

# Optional AI text generation backend. Keep secrets only on the server.
# OpenAI-compatible Chat Completions endpoint.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Allowed frontend origin for cross-domain calls from GitHub Pages.
SITE_ORIGIN=https://neyro-hcp.github.io
